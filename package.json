{
  "name": "utilint",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/passkey": "1.7.2",
      "@better-auth/oauth-provider": "1.7.2",
      "better-auth": "1.7.2",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "dev": "bun run --bun turbo dev",
    "build": "bun run --bun turbo build",
    "build:local": "BUILD_TARGET=host bun run --bun turbo build --filter=@repo/backend",
    "check:types": "bun run --bun turbo check:types",
    "check:codestyle": "biome check .",
    "test": "bun run --bun turbo test",
    "test:e2e": "bun run --filter @repo/frontend build && bun scripts/e2e.ts",
    "check:all": "bun run check:types && bun run check:codestyle && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  }
}
